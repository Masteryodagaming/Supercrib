# Firebase web app config (Console → Project settings → Your apps)
# Use the free Spark plan. Enable Realtime Database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Tournament owner gate (Club Night). Email must match the signed-in account.
VITE_OWNER_USER_ID=
VITE_OWNER_EMAIL=j0shwa@hotmail.com
VITE_OWNER_USERNAME=
# false = only owner creates/starts; true = any logged-in can host (owner still admin)
VITE_TOURNAMENTS_PUBLIC_HOSTING=false

# Optional Metered TURN credentials URL (preview hard-NAT)
# VITE_METERED_TURN_API_URL=https://<app>.metered.live/api/v1/turn/credentials?apiKey=...
